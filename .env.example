# 環境變數配置範例
# 複製此檔案為 .env 並根據需要修改設定值

# === 通用設定 ===
NODE_ENV=development
COMPOSE_PROJECT_NAME=confidential-ai

# === App Server 設定 ===
APP_PORT=3001
SQLITE_DB_PATH=./sqlite/db.sqlite
AI_SERVICE_URL=http://ai-service:8000

# === AI Service 設定 ===
AI_PORT=8000
CHROMA_DIR=/app/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
# ChromaDB 配置
CHROMA_TELEMETRY_ENABLED=false

# === 前端設定 (可選) ===
VITE_APP_SERVER_URL=http://localhost:3001

# === Docker 設定 ===
# 資料卷掛載路徑
HOST_SQLITE_PATH=./app-server/sqlite
HOST_CHROMA_PATH=./ai-service/chroma_db
HOST_RULE_REF_PATH=./rule_ref
